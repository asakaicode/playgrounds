{
  "name": "virtual-waiting-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:worker": "tsx watch server/src/worker.ts",
    "dev:public": "node esbuild.config.js --watch",
    "build:server": "tsc -p server/tsconfig.json && node -e \"require('node:fs').cpSync('server/src/lua','dist/server/src/lua',{recursive:true})\"",
    "build:public": "node esbuild.config.js",
    "build": "npm run build:server && npm run build:public",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p public/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "load-test": "tsx server/scripts/load.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "@eslint/js": "^9.17.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
